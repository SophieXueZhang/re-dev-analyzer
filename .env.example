# RE Dev Analyzer - Environment Variables
# Copy this file to .env and fill in the values

# ============================================================
# AI Model API (REQUIRED - pick one)
# ============================================================

# Option 1: OpenRouter (recommended, free tier available)
# Sign up: https://openrouter.ai/
# Free models available: google/gemini-2.0-flash-exp:free
AI_GATEWAY_API_KEY=your_openrouter_api_key_here

# ============================================================
# Web Search API (REQUIRED - pick one)
# ============================================================

# Option 1: Brave Search API (recommended, free: 2000 queries/month)
# Sign up: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# Option 2: SerpAPI (free: 100 searches/month)
# Sign up: https://serpapi.com/
# SERP_API_KEY=your_serpapi_key_here
